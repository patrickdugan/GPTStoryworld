; Native symbolic teacher policy for storyworld factory control routing.
; These atoms are used as a compact MeTTa-style reasoning schema, not as a
; claim that the current Python runner executes MeTTa directly.

(Role mcp_context_router)
(Role world_state_summarizer)
(Role llm_prompt_composer)
(Role option_manifold_planner)
(Role reaction_dynamics_mapper)
(Role effect_script_synthesizer)
(Role gate_secret_route_designer)
(Role validator_repair_critic)
(Role commit_veto_controller)

(RouteFailure context_overflow mcp_context_router)
(RouteFailure insufficient_neighbor_context mcp_context_router)
(RouteFailure dangling_consequence validator_repair_critic)
(RouteFailure unsupported_reader_operator validator_repair_critic)
(RouteFailure schema_parse_error validator_repair_critic)
(RouteFailure effect_nudge_monoculture effect_script_synthesizer)
(RouteFailure missing_pvalue_refs effect_script_synthesizer)
(RouteFailure missing_p2value_refs effect_script_synthesizer)
(RouteFailure unreachable_secret gate_secret_route_designer)
(RouteFailure gate_threshold_unforeshadowed gate_secret_route_designer)
(RouteFailure reaction_collapse reaction_dynamics_mapper)
(RouteFailure option_blandness option_manifold_planner)
(RouteFailure too_much_llm_freeform llm_prompt_composer)
(RouteFailure no_metric_delta commit_veto_controller)

(RouteObjective fit_context_budget mcp_context_router)
(RouteObjective repair_context_packet mcp_context_router)
(RouteObjective repair_schema_connectivity validator_repair_critic)
(RouteObjective repair_reader_semantics validator_repair_critic)
(RouteObjective diversify_effect_scripts effect_script_synthesizer)
(RouteObjective repair_secret_route_reachability gate_secret_route_designer)
(RouteObjective restore_reaction_contrast reaction_dynamics_mapper)
(RouteObjective improve_option_manifold option_manifold_planner)
(RouteObjective avoid_noop_repair commit_veto_controller)

(Priority failure_route 100)
(Priority objective_route 90)
(Priority budget_overflow_route 95)
(Priority connectivity_route 85)
(Priority effect_variety_route 80)
(Priority reaction_contrast_route 75)
(Priority secret_route 70)
(Priority validator_error_route 65)

(TeacherPolicy native_master_control_schema)
