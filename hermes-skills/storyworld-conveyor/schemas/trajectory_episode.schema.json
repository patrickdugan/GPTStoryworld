{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moralitylab.local/storyworld-conveyor/trajectory_episode.schema.json",
  "title": "Storyworld Conveyor Trajectory Episode",
  "type": "object",
  "required": [
    "episode_id",
    "world_id",
    "model_tier",
    "context_budget_tokens",
    "objective",
    "initial_metrics",
    "steps",
    "final_metrics",
    "episode_label"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "model_tier": {
      "type": "string",
      "examples": ["9B_Q4", "27B_Q4", "no_llm_deterministic"]
    },
    "context_budget_tokens": {
      "type": "integer",
      "minimum": 256
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "initial_metrics": {
      "$ref": "#/$defs/metrics"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "final_metrics": {
      "$ref": "#/$defs/metrics"
    },
    "episode_label": {
      "type": "object",
      "required": ["success", "reward"],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "best_next_role": {
          "type": "string"
        },
        "failure_class": {
          "type": "string"
        },
        "reward": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "boolean", "string", "null"]
      }
    },
    "step": {
      "type": "object",
      "required": ["role_id", "chosen_action", "accepted"],
      "properties": {
        "role_id": {
          "type": "string"
        },
        "state_ref": {
          "type": "string"
        },
        "chosen_action": {
          "type": "string"
        },
        "llm_call_type": {
          "type": "string"
        },
        "context_packet_ref": {
          "type": "string"
        },
        "output_ref": {
          "type": "string"
        },
        "verifier_delta_ref": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
